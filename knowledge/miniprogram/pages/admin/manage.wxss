/* 管理页面样式 */
.container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部标题栏 */
.header {
  background-color: white;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 标签页 */
.tabs {
  display: flex;
  background-color: white;
  padding: 0 30rpx;
  border-bottom: 2rpx solid #eee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: 32rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #4CAF50;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 6rpx;
  background-color: #4CAF50;
  border-radius: 3rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.btn-add {
  background-color: #4CAF50;
  color: white;
  font-size: 28rpx;
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
}

.btn-add image {
  width: 36rpx;
  height: 36rpx;
  margin-right: 8rpx;
}

/* 筛选栏 */
.filter-bar {
  background-color: white;
  padding: 20rpx 0;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  padding: 0 30rpx;
}

.filter-item {
  background-color: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  padding: 15rpx 30rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
}

.filter-item.active {
  background-color: #4CAF50;
  color: white;
}

/* 题目列表 */
.question-list {
  padding: 30rpx;
}

/* 题目卡片 */
.question-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
}

.subject-tag {
  background-color: #E8F5E9;
  color: #4CAF50;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.answer-tag {
  background-color: #FFF3E0;
  color: #FF9800;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.card-title {
  font-size: 32rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 15rpx;
}

.card-options {
  background-color: #f9f9f9;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 15rpx;
}

.card-options text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.card-options text:last-child {
  margin-bottom: 0;
}

.card-analysis {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  padding-top: 15rpx;
  border-top: 1rpx solid #eee;
  margin-bottom: 20rpx;
}

.card-analysis .label {
  color: #2196F3;
  font-weight: bold;
}

.card-actions {
  display: flex;
  gap: 20rpx;
}

.btn-edit {
  flex: 1;
  background-color: #E3F2FD;
  color: #1976D2;
  border: 2rpx solid #1976D2;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.btn-delete {
  flex: 1;
  background-color: #FFEBEE;
  color: #f44336;
  border: 2rpx solid #f44336;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 28rpx;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
}

.modal-content {
  background-color: white;
  width: 100%;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  max-height: 90vh;
  overflow-y: auto;
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-group {
  margin-bottom: 25rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.btn-cancel {
  flex: 1;
  background-color: #f5f5f5;
  color: #666;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

.btn-submit {
  flex: 1;
  background-color: #4CAF50;
  color: white;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
}

/* 用户列表 */
.user-list {
  padding: 30rpx;
}

/* 用户卡片 */
.user-card {
  background-color: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 25rpx;
  border: 3rpx solid #eee;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 10rpx;
}

.user-detail {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 5rpx;
}

.user-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.user-actions .btn-edit {
  width: 100rpx;
  height: 60rpx;
  font-size: 24rpx;
  padding: 0;
}

.user-actions .btn-delete {
  width: 100rpx;
  height: 60rpx;
  font-size: 24rpx;
  padding: 0;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.5;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
