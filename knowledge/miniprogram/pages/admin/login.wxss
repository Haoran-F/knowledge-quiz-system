/* 管理员登录页面样式 */
.container {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  position: relative;
  overflow: hidden;
}

.bg-gradient {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.bg-image {
  width: 100%;
  height: 100%;
}

.login-box {
  position: relative;
  z-index: 1;
  background-color: white;
  width: 100%;
  max-width: 600rpx;
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  box-shadow: 0 20rpx 40rpx rgba(0, 0, 0, 0.1);
}

.logo {
  width: 100rpx;
  height: 100rpx;
  margin: 0 auto 20rpx;
  display: block;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  display: block;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  display: block;
  margin-bottom: 50rpx;
}

.form-group {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin-bottom: 10rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background-color: #f5f5f5;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
}

.btn-login {
  width: 100%;
  height: 88rpx;
  background-color: #4CAF50;
  color: white;
  font-size: 32rpx;
  border-radius: 44rpx;
  margin-top: 20rpx;
  margin-bottom: 30rpx;
}

.tips {
  font-size: 24rpx;
  color: #999;
  text-align: center;
}
