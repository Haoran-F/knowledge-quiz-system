/* 首页样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f7fa 30%, #f8f9fc 100%);
  padding-bottom: 120rpx;
}

/* ========== 头部区域 ========== */
.header {
  position: relative;
  padding: 50rpx 40rpx 50rpx;
  border-radius: 0 0 48rpx 48rpx;
  overflow: hidden;
}

.header-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.header-content {
  position: relative;
  z-index: 1;
}

.greeting-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.greeting-text {
  display: flex;
  align-items: baseline;
}

.hello-text {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.9);
}

.user-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
}

.header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  background-color: rgba(255, 255, 255, 0.2);
}

.welcome {
  position: relative;
  z-index: 1;
  color: white;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 10rpx;
}

.logo {
  width: 110rpx;
  height: 110rpx;
  margin-bottom: 20rpx;
  opacity: 0.95;
  filter: drop-shadow(0 4rpx 12rpx rgba(0, 0, 0, 0.15));
}

.title {
  font-size: 52rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 12rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 4rpx;
}

.subtitle {
  font-size: 28rpx;
  opacity: 0.92;
  letter-spacing: 1rpx;
}

/* ========== 科目列表 ========== */
.subject-list {
  padding: 20rpx 30rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title-left {
  display: flex;
  align-items: center;
}

.title-dot {
  width: 8rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #4CAF50, #81c784);
  border-radius: 4rpx;
  margin-right: 14rpx;
}

.title-text {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
}

/* ========== 科目卡片 ========== */
.subject-card {
  position: relative;
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.card-hover {
  transform: scale(0.98);
  transition: transform 0.1s ease;
}

.card-icon {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1a1a1a;
  display: block;
  margin-bottom: 10rpx;
  letter-spacing: 2rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #888;
}

.card-arrow {
  position: relative;
  z-index: 1;
}

.arrow-icon {
  font-size: 44rpx;
  color: #bbb;
  font-weight: 300;
  margin-left: 2rpx;
}

/* ========== 每日小贴士 ========== */
.tip-card {
  margin: 10rpx 30rpx 30rpx;
  background: linear-gradient(135deg, #fff9e6 0%, #fff5f0 100%);
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: flex-start;
  border: 2rpx solid #ffe4b5;
}

.tip-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background-color: #fff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(255, 193, 7, 0.2);
}

.tip-emoji {
  font-size: 40rpx;
}

.tip-content {
  flex: 1;
}

.tip-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #e67e22;
  margin-bottom: 8rpx;
}

.tip-text {
  font-size: 26rpx;
  color: #8b6914;
  line-height: 1.6;
}

/* ========== 底部提示 ========== */
.footer {
  text-align: center;
  padding: 50rpx 20rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.footer-text {
  font-size: 24rpx;
  color: #bbb;
  letter-spacing: 4rpx;
  margin-bottom: 12rpx;
}

.footer-sub {
  font-size: 26rpx;
  color: #999;
}
