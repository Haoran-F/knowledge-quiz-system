<!-- 所有题目列表页面 -->
<view class="container">
  <!-- 头部渐变背景 -->
  <view class="header">
    <view class="header-deco deco-1"></view>
    <view class="header-deco deco-2"></view>
    <view class="header-content">
      <text class="title">📚 题库中心</text>
      <view class="stats-row">
        <view class="stat-item">
          <text class="stat-num">{{totalCount}}</text>
          <text class="stat-label">总题目</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{filteredCount}}</text>
          <text class="stat-label">{{currentSubject || '全部'}}</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{searchCount}}</text>
          <text class="stat-label">搜索结果</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索框 -->
  <view class="search-wrap">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索题目内容..." 
        placeholder-class="search-placeholder"
        value="{{searchText}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <view class="search-clear" wx:if="{{searchText}}" bindtap="onClearSearch">✕</view>
    </view>
  </view>

  <!-- 科目筛选条 -->
  <view class="filter-bar">
    <scroll-view scroll-x class="filter-scroll" enhanced show-scrollbar="{{false}}">
      <view class="filter-list">
        <view 
          wx:for="{{subjectList}}" 
          wx:key="index"
          class="filter-item {{currentSubject === item ? 'active' : ''}}"
          bindtap="filterBySubject"
          data-subject="{{item}}"
        >
          <text class="filter-text">{{item}}</text>
          <view class="filter-badge" wx:if="{{item === '全部'}}">{{totalCount}}</view>
          <view class="filter-badge" wx:else>{{getSubjectCount(item)}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 题目列表 -->
  <view class="question-list" wx:if="{{displayList.length > 0}}">
    <view wx:for="{{displayList}}" wx:key="q_id" class="question-card" bindtap="toggleExpand" data-qid="{{item.q_id}}">
      <view class="card-deco"></view>
      <view class="card-header">
        <view class="header-left">
          <view class="id-tag">#{{item.q_id}}</view>
          <view class="subject-tag" style="background: {{getSubjectGradient(item.subject_name)}}">
            <text class="subject-icon">{{getSubjectIcon(item.subject_name)}}</text>
            <text>{{item.subject_name}}</text>
          </view>
        </view>
        <view class="expand-icon">{{expandedIds[item.q_id] ? '▲' : '▼'}}</view>
      </view>
      <view class="card-title">{{item.title}}</view>
      <view class="card-options" wx:if="{{expandedIds[item.q_id]}}">
        <text class="option">A. {{item.option_A}}</text>
        <text class="option">B. {{item.option_B}}</text>
        <text class="option">C. {{item.option_C}}</text>
        <text class="option">D. {{item.option_D}}</text>
      </view>
      <view class="card-answer" wx:if="{{expandedIds[item.q_id]}}">
        <text class="label">✅ 答案：</text>
        <text class="answer">{{item.answer}}</text>
      </view>
      <view class="card-analysis" wx:if="{{expandedIds[item.q_id] && item.analysis}}">
        <text class="label">💡 解析：</text>
        <text>{{item.analysis}}</text>
      </view>
      <view class="card-footer" wx:if="{{expandedIds[item.q_id]}}">
        <view class="card-action">
          <button class="btn-add-wrong" catchtap="addToWrong" data-qid="{{item.q_id}}">
            <text class="btn-icon">📝</text>
            加入错题本
          </button>
        </view>
      </view>
      <view class="card-preview-hint" wx:if="{{!expandedIds[item.q_id]}}">
        <text class="hint-text">👆 点击卡片展开查看答案和解析</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{displayList.length === 0}}">
    <text class="empty-icon">🔍</text>
    <text class="empty-title">暂无匹配的题目</text>
    <text class="empty-desc">换个关键词或筛选科目试试</text>
  </view>
</view>
