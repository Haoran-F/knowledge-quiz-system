/* 所有题目列表页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f9f0 0%, #f5f7fa 30%, #eef2f7 100%);
  padding-bottom: 60rpx;
  position: relative;
}

/* 头部渐变背景 */
.header {
  position: relative;
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 50%, #66BB6A 100%);
  padding: 40rpx 30rpx 60rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(46, 125, 50, 0.25);
}

.header-deco {
  position: absolute;
  border-radius: 50%;
  opacity: 0.15;
  background: #ffffff;
}

.deco-1 {
  width: 300rpx;
  height: 300rpx;
  top: -100rpx;
  right: -80rpx;
}

.deco-2 {
  width: 200rpx;
  height: 200rpx;
  bottom: -80rpx;
  left: -60rpx;
  opacity: 0.1;
}

.header-content {
  position: relative;
  z-index: 2;
}

.title {
  font-size: 42rpx;
  font-weight: bold;
  color: #ffffff;
  display: block;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.stats-row {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 24rpx 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  line-height: 1.2;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
}

.stat-divider {
  width: 1rpx;
  height: 50rpx;
  background: rgba(255, 255, 255, 0.3);
}

/* 搜索框 */
.search-wrap {
  padding: 0 24rpx;
  margin-top: -30rpx;
  position: relative;
  z-index: 10;
}

.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 50rpx;
  padding: 18rpx 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(46, 125, 50, 0.12), 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: 1rpx solid rgba(46, 125, 50, 0.08);
}

.search-icon {
  font-size: 30rpx;
  margin-right: 16rpx;
  opacity: 0.7;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
}

.search-placeholder {
  color: #bbb;
  font-size: 28rpx;
}

.search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #e0e0e0;
  color: #888;
  font-size: 22rpx;
  margin-left: 12rpx;
}

/* 筛选栏 */
.filter-bar {
  background: transparent;
  padding: 24rpx 0 10rpx;
}

.filter-scroll {
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  padding: 0 24rpx;
}

.filter-item {
  display: inline-flex;
  align-items: center;
  padding: 18rpx 32rpx;
  margin-right: 18rpx;
  background: #ffffff;
  border-radius: 50rpx;
  font-size: 28rpx;
  color: #666;
  box-shadow: 0 4rpx 14rpx rgba(0, 0, 0, 0.05);
  border: 1rpx solid #eef0f3;
  transition: all 0.25s ease;
  position: relative;
}

.filter-item.active {
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(46, 125, 50, 0.3);
  border-color: transparent;
  transform: translateY(-2rpx);
}

.filter-text {
  font-weight: 500;
}

.filter-badge {
  margin-left: 12rpx;
  min-width: 36rpx;
  padding: 0 10rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  background: rgba(0, 0, 0, 0.06);
  color: inherit;
  font-size: 22rpx;
  font-weight: bold;
}

.filter-item.active .filter-badge {
  background: rgba(255, 255, 255, 0.25);
  color: #ffffff;
}

/* 题目列表 */
.question-list {
  padding: 20rpx 24rpx;
}

/* 题目卡片 */
.question-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06), 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  overflow: hidden;
  transition: all 0.3s ease;
}

.question-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.card-deco {
  position: absolute;
  top: 0;
  left: 0;
  width: 8rpx;
  height: 100%;
  background: linear-gradient(180deg, #2E7D32 0%, #66BB6A 100%);
  border-radius: 24rpx 0 0 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-left: 10rpx;
}

.header-left {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
}

.id-tag {
  padding: 8rpx 18rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
  letter-spacing: 1rpx;
  box-shadow: 0 4rpx 10rpx rgba(26, 26, 46, 0.25);
}

.subject-tag {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.12);
}

.subject-icon {
  margin-right: 8rpx;
  font-size: 22rpx;
}

.expand-icon {
  font-size: 22rpx;
  color: #aaa;
  padding: 6rpx 10rpx;
  transition: transform 0.3s ease;
}

.card-title {
  font-size: 32rpx;
  color: #1a1a2e;
  line-height: 1.6;
  margin-bottom: 18rpx;
  padding-left: 10rpx;
  font-weight: 500;
}

.card-options {
  background: linear-gradient(180deg, #f8faf8 0%, #f0f4f0 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(46, 125, 50, 0.06);
}

.option {
  display: block;
  font-size: 28rpx;
  color: #444;
  margin-bottom: 14rpx;
  line-height: 1.5;
  padding-left: 8rpx;
}

.option:last-child {
  margin-bottom: 0;
}

.card-answer {
  font-size: 28rpx;
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
  border-radius: 14rpx;
  border-left: 6rpx solid #4CAF50;
}

.card-answer .label {
  color: #2E7D32;
  font-weight: bold;
}

.card-answer .answer {
  font-weight: bold;
  color: #2E7D32;
  font-size: 32rpx;
  margin-left: 4rpx;
}

.card-analysis {
  font-size: 26rpx;
  color: #555;
  line-height: 1.7;
  padding: 20rpx;
  background: linear-gradient(135deg, #fff8e1 0%, #ffecb3 100%);
  border-radius: 14rpx;
  border-left: 6rpx solid #FFC107;
  margin-bottom: 16rpx;
}

.card-analysis .label {
  color: #F57C00;
  font-weight: bold;
  display: inline-block;
  margin-bottom: 6rpx;
}

.card-footer {
  padding-top: 16rpx;
  border-top: 1rpx dashed #e0e0e0;
  margin-top: 24rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

/* 加入错题本按钮 */
.card-action {
  display: flex;
  justify-content: flex-end;
}

.btn-add-wrong {
  background: linear-gradient(135deg, #FF9800 0%, #FFB74D 100%);
  color: #ffffff;
  font-size: 26rpx;
  padding: 14rpx 34rpx;
  border-radius: 40rpx;
  border: none;
  display: inline-flex;
  align-items: center;
  box-shadow: 0 6rpx 18rpx rgba(255, 152, 0, 0.35);
  font-weight: 500;
  line-height: 1.4;
}

.btn-add-wrong::after {
  border: none;
}

.btn-icon {
  font-size: 26rpx;
  margin-right: 8rpx;
}

.card-preview-hint {
  margin-top: 8rpx;
  padding: 14rpx;
  background: linear-gradient(90deg, rgba(46, 125, 50, 0.05) 0%, transparent 100%);
  border-radius: 12rpx;
  text-align: center;
}

.hint-text {
  font-size: 24rpx;
  color: #888;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.4;
  margin-bottom: 30rpx;
}

.empty-title {
  font-size: 32rpx;
  color: #666;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #aaa;
}
