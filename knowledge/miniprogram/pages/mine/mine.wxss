/* 个人中心页面样式 */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f4ff 0%, #f5f7fa 30%, #f8f9fc 100%);
  padding-bottom: 60rpx;
}

/* 头部渐变区域 */
.user-area {
  position: relative;
  background: linear-gradient(135deg, #4CAF50 0%, #2E7D32 50%, #1B5E20 100%);
  padding: 100rpx 40rpx 140rpx;
  overflow: hidden;
  border-radius: 0 0 60rpx 60rpx;
}

.deco-circle {
  position: absolute;
  border-radius: 50%;
  background: #fff;
  opacity: 0.1;
  pointer-events: none;
}

.dc1 {
  width: 360rpx;
  height: 360rpx;
  top: -140rpx;
  right: -100rpx;
}

.dc2 {
  width: 240rpx;
  height: 240rpx;
  bottom: -80rpx;
  left: -60rpx;
}

.dc3 {
  width: 120rpx;
  height: 120rpx;
  top: 120rpx;
  left: 60rpx;
  opacity: 0.08;
}

/* 已登录用户信息 */
.user-info {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255,255,255,0.5);
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}

.avatar-badge {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #c8e6c9, #a5d6a7);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  border: 4rpx solid #fff;
}

.user-detail {
  margin-left: 30rpx;
  flex: 1;
  min-width: 0;
}

.hello-row {
  margin-bottom: 8rpx;
}

.hello-text {
  font-size: 28rpx;
  color: rgba(255,255,255,0.9);
}

.user-name {
  font-size: 44rpx;
  font-weight: bold;
  color: white;
  display: block;
  margin-bottom: 14rpx;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,0.15);
}

.user-meta {
  display: flex;
}

.user-id-badge {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.18);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  backdrop-filter: blur(6rpx);
}

/* 未登录访客区域 */
.guest-area {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.guest-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  background: rgba(255,255,255,0.18);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  backdrop-filter: blur(8rpx);
}

.guest-icon {
  font-size: 80rpx;
}

.guest-title {
  font-size: 40rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
}

.guest-subtitle {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  margin-bottom: 40rpx;
}

.btn-login {
  background: white;
  color: #2E7D32;
  font-size: 30rpx;
  font-weight: 500;
  padding: 24rpx 80rpx;
  border-radius: 50rpx;
  border: none;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.15);
}

.btn-login::after {
  border: none;
}

.login-icon {
  font-size: 34rpx;
  margin-right: 12rpx;
}

/* 菜单分组 */
.menu-wrapper {
  padding: 10rpx 30rpx 0;
}

.menu-group {
  margin-bottom: 36rpx;
}

.group-title {
  display: flex;
  align-items: center;
  padding: 20rpx 10rpx;
  margin-bottom: 16rpx;
}

.gt-line {
  flex: 1;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, #c8e6c9, transparent);
}

.gt-text {
  font-size: 28rpx;
  color: #2E7D32;
  font-weight: bold;
  padding: 0 20rpx;
  white-space: nowrap;
}

.menu-list {
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(46,125,50,0.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 26rpx;
  border-bottom: 2rpx solid #f5f6fa;
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f1f8e9;
}

.menu-item-danger .mi-text {
  color: #e53935;
}

.mi-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.miw-purple {
  background: linear-gradient(135deg, #f3e5f5 0%, #e1bee7 100%);
}

.miw-green {
  background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
}

.miw-pink {
  background: linear-gradient(135deg, #fce4ec 0%, #f8bbd0 100%);
}

.miw-indigo {
  background: linear-gradient(135deg, #e8eaf6 0%, #c5cae9 100%);
}

.miw-cyan {
  background: linear-gradient(135deg, #e0f7fa 0%, #b2ebf2 100%);
}

.miw-red {
  background: linear-gradient(135deg, #ffebee 0%, #ffcdd2 100%);
}

.mi-icon {
  font-size: 36rpx;
}

.mi-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.mi-text {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.mi-desc {
  font-size: 24rpx;
  color: #aaa;
}

.mi-arrow {
  font-size: 40rpx;
  color: #ccc;
  margin-left: 10rpx;
  flex-shrink: 0;
  font-weight: 300;
}

/* 未登录提示 */
.tips {
  padding: 60rpx 40rpx 30rpx;
}

.tips-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.04);
}

.tips-emoji {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.tips-text {
  font-size: 28rpx;
  color: #777;
}

/* 底部标语与版本 */
.slogan-area {
  padding: 50rpx 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.slogan-divider {
  width: 120rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: linear-gradient(90deg, transparent, #a5d6a7, transparent);
  margin-bottom: 24rpx;
}

.slogan-text {
  font-size: 26rpx;
  color: #2E7D32;
  font-weight: 500;
  margin-bottom: 20rpx;
  letter-spacing: 1rpx;
}

.version {
  font-size: 22rpx;
  color: #bbb;
  padding: 10rpx 0;
}
