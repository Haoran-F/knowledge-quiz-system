<!-- 个人中心页面 -->
<view class="container">
  <!-- 头部渐变背景 -->
  <view class="user-area">
    <view class="deco-circle dc1"></view>
    <view class="deco-circle dc2"></view>
    <view class="deco-circle dc3"></view>

    <!-- 已登录状态 -->
    <view class="user-info" wx:if="{{userInfo}}">
      <view class="avatar-wrap" bindtap="chooseAvatar">
        <image class="avatar" src="{{userInfo.wx_avatar || '/images/icon-user.png'}}" mode="aspectFill"></image>
        <view class="avatar-badge">📷</view>
      </view>
      <view class="user-detail">
        <view class="hello-row">
          <text class="hello-text">👋 你好，</text>
        </view>
        <text class="user-name">{{userInfo.wx_name || '用户同学'}}</text>
        <view class="user-meta">
          <text class="user-id-badge">ID: {{userInfo.user_id}}</text>
        </view>
      </view>
    </view>

    <!-- 未登录状态 -->
    <view class="guest-area" wx:else>
      <view class="guest-icon-wrap">
        <text class="guest-icon">👤</text>
      </view>
      <text class="guest-title">欢迎来到知识题库</text>
      <text class="guest-subtitle">登录后可保存学习进度和错题本</text>
      <button class="btn-login" bindtap="wxLogin">
        <text class="login-icon">💬</text>
        <text>微信一键登录</text>
      </button>
    </view>
  </view>

  <!-- 功能菜单（分组） -->
  <view class="menu-wrapper" wx:if="{{userInfo}}">
    <!-- 学习工具组 -->
    <view class="menu-group">
      <view class="group-title">
        <view class="gt-line"></view>
        <text class="gt-text">📖 学习工具</text>
        <view class="gt-line"></view>
      </view>
      <view class="menu-list">
        <view class="menu-item" bindtap="goToWrong">
          <view class="mi-icon-wrap miw-purple">
            <text class="mi-icon">✏️</text>
          </view>
          <view class="mi-content">
            <text class="mi-text">我的错题本</text>
            <text class="mi-desc">回顾复习，查漏补缺</text>
          </view>
          <text class="mi-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="viewAllQuestions">
          <view class="mi-icon-wrap miw-green">
            <text class="mi-icon">📋</text>
          </view>
          <view class="mi-content">
            <text class="mi-text">全部题目</text>
            <text class="mi-desc">浏览所有题库内容</text>
          </view>
          <text class="mi-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="confirmClearAllWrong">
          <view class="mi-icon-wrap miw-pink">
            <text class="mi-icon">🗑️</text>
          </view>
          <view class="mi-content">
            <text class="mi-text">清空错题本</text>
            <text class="mi-desc">一键清除所有错题记录</text>
          </view>
          <text class="mi-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 系统设置组 -->
    <view class="menu-group">
      <view class="group-title">
        <view class="gt-line"></view>
        <text class="gt-text">⚙️ 系统设置</text>
        <view class="gt-line"></view>
      </view>
      <view class="menu-list">
        <view class="menu-item" bindtap="goToAdmin">
          <view class="mi-icon-wrap miw-indigo">
            <text class="mi-icon">🔧</text>
          </view>
          <view class="mi-content">
            <text class="mi-text">管理员入口</text>
            <text class="mi-desc">后台管理登录</text>
          </view>
          <text class="mi-arrow">›</text>
        </view>
        <view class="menu-item" bindtap="chooseAvatar">
          <view class="mi-icon-wrap miw-cyan">
            <text class="mi-icon">🖼️</text>
          </view>
          <view class="mi-content">
            <text class="mi-text">更换头像</text>
            <text class="mi-desc">从相册或拍照选择</text>
          </view>
          <text class="mi-arrow">›</text>
        </view>
        <view class="menu-item menu-item-danger" bindtap="logout">
          <view class="mi-icon-wrap miw-red">
            <text class="mi-icon">🚪</text>
          </view>
          <view class="mi-content">
            <text class="mi-text">退出登录</text>
            <text class="mi-desc">安全退出当前账号</text>
          </view>
          <text class="mi-arrow">›</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 未登录提示 -->
  <view class="tips" wx:if="{{!userInfo}}">
    <view class="tips-card">
      <text class="tips-emoji">🔐</text>
      <text class="tips-text">登录后可使用错题本功能</text>
    </view>
  </view>

  <!-- 底部标语 -->
  <view class="slogan-area">
    <view class="slogan-divider"></view>
    <text class="slogan-text">✨ 知识改变命运 · 学习成就未来 ✨</text>
    <view class="version">
      <text>知识题库系统 by 冯昊冉</text>
    </view>
  </view>
</view>
